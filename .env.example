# ======================================================================
# MAILTRACE AI — Environment Configuration Reference
# ======================================================================

# --- Server Configuration ---
# Render sets PORT automatically. Default: 8000
PORT=8000

# Enables real-time log flushing in Render console
PYTHONUNBUFFERED=1

# --- Persistence ---
# Optional: Path to SQLite database. Default: backend/mailtrace.db
# On Render with Persistent Disk: /var/data/mailtrace.db
# DATABASE_PATH=/var/data/mailtrace.db

# --- Frontend API Connector (Only needed if Frontend is hosted separately) ---
# If using unified Docker deployment, leave this unset or empty.
# If hosting Frontend on Render Static Site and Backend on Render Web Service:
# VITE_API_BASE_URL=https://mailtrace-api.onrender.com
